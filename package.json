{
  "name": "aqua-prime",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not IE 11"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:ui": "playwright test tests/e2e --ui",
    "test:e2e:headed": "playwright test tests/e2e --headed",
    "test:e2e:debug": "playwright test tests/e2e --debug",
    "test:ai": "ts-node tests/e2e/test-runner.ts",
    "build:android": "npm run build && npx cap sync android && npx cap open android",
    "sync:android": "npx cap sync android",
    "open:android": "npx cap open android",
    "build:apk:debug": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "build:apk:release": "npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease",
    "build:aab:debug": "npm run build && npx cap sync android && cd android && gradlew.bat bundleDebug",
    "build:aab:release": "npm run build && npx cap sync android && cd android && gradlew.bat bundleRelease",
    "build:android:release": "npm run build && npx cap sync android && cd android && gradlew.bat bundleRelease",
    "verify:build": "npm run lint && npm run test && npm run build",
    "version:patch": "npm version patch && node -e \"const v=require('./package.json').version; const fs=require('fs'); let b=fs.readFileSync('android/app/build.gradle','utf8'); b=b.replace(/versionCode \\d+/g,'versionCode '+(parseInt(b.match(/versionCode (\\d+)/)[1])+1)); b=b.replace(/versionName \\\"[^\\\"]+\\\"/g,'versionName \\\"'+v+'\\\"'); fs.writeFileSync('android/app/build.gradle',b); console.log('Synced version to '+v);\"",
    "version:minor": "npm version minor && node -e \"const v=require('./package.json').version; const fs=require('fs'); let b=fs.readFileSync('android/app/build.gradle','utf8'); b=b.replace(/versionCode \\d+/g,'versionCode '+(parseInt(b.match(/versionCode (\\d+)/)[1])+1)); b=b.replace(/versionName \\\"[^\\\"]+\\\"/g,'versionName \\\"'+v+'\\\"'); fs.writeFileSync('android/app/build.gradle',b); console.log('Synced version to '+v);\"",
    "version:major": "npm version major && node -e \"const v=require('./package.json').version; const fs=require('fs'); let b=fs.readFileSync('android/app/build.gradle','utf8'); b=b.replace(/versionCode \\d+/g,'versionCode '+(parseInt(b.match(/versionCode (\\d+)/)[1])+1)); b=b.replace(/versionName \\\"[^\\\"]+\\\"/g,'versionName \\\"'+v+'\\\"'); fs.writeFileSync('android/app/build.gradle',b); console.log('Synced version to '+v);\"",
    "prepare": "husky"
  },
  "dependencies": {
