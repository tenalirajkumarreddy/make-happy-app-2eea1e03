      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n  \n  body {\n    font-family: 'Inter', sans-serif;\n    background-color: #f8fafc;\n    color: #1e293b;\n    margin: 0;\n    padding: 0;\n  }\n\n  .tint-shadow-blue {\n    box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.2), 0 8px 10px -6px rgba(79, 70, 229, 0.1);\n  }\n\n  .tint-shadow-emerald {\n    box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.1), 0 8px 10px -6px rgba(16, 185, 129, 0.1);\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar {\n    width: 4px;\n  }\n  ::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  ::-webkit-scrollbar-thumb {\n    background: #e2e8f0;\n    border-radius: 10px;\n  }\n</style>\n\n<div class=\"max-w-[375px] mx-auto min-h-[900px] bg-slate-50 relative flex flex-col\" data-kid=\"1\">\n  \n  \n  <header class=\"px-5 py-4 flex items-center justify-between bg-white border-b border-slate-100 relative z-20\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3\" data-kid=\"3\">\n      <div class=\"w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center border border-indigo-100\" data-kid=\"4\">\n        <svg class=\"w-5 h-5 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" data-kid=\"5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\" data-kid=\"6\"></path></svg>\n      </div>\n      <div data-kid=\"7\">\n        <p class=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none\" data-kid=\"8\">Sales Agent</p>\n        <h2 class=\"text-sm font-bold text-slate-800\" data-kid=\"9\">Rahul Sharma</h2>\n      </div>\n    </div>\n    <button class=\"w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-all border border-slate-100\" d