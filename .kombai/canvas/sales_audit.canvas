items-center text-xs\" data-kid=\"240\">\n                <span class=\"text-slate-400 font-medium\" data-kid=\"241\">Subtotal</span>\n                <span class=\"font-mono font-bold\" data-kid=\"242\">₹3,250.00</span>\n              </div>\n              <div class=\"flex justify-between items-center text-xs\" data-kid=\"243\">\n                <span class=\"text-slate-400 font-medium\" data-kid=\"244\">Applied Discount</span>\n                <span class=\"text-[var(--success)] font-mono font-bold\" data-kid=\"245\">- ₹0.00</span>\n              </div>\n              <div class=\"flex justify-between items-center pt-3 border-t border-white/10\" data-kid=\"246\">\n                <span class=\"text-lg font-bold\" data-kid=\"247\">Total Due</span>\n                <span class=\"text-2xl font-bold font-mono tracking-tighter\" data-kid=\"248\">₹3,250.00</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <footer class=\"p-6 border-t border-[var(--border)] bg-white sticky bottom-0 z-10\" data-kid=\"249\">\n        <button class=\"w-full bg-[var(--primary)] hover:opacity-90 text-white py-4 rounded-xl font-bold text-base shadow-xl shadow-blue-200/50 transition-all flex items-center justify-center gap-3 active:scale-[0.98]\" data-kid=\"250\">\n          Confirm Transaction\n          <i data-lucide=\"arrow-right\" class=\"w-5 h-5\" data-kid=\"251\"></i>\n        </button>\n      </footer>\n    </div>\n  </div>\n</div>\n\n<script data-kid=\"252\">\n  // Initialize Lucide\n  lucide.createIcons();\n\n  // Keyboard shortcut to close panel\n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      document.getElementById('record-sale-panel').classList.add('hidden');\n      document.getElementById('filter-popover').classList.add('hidden');\n    }\n  });\n</script>\n",
