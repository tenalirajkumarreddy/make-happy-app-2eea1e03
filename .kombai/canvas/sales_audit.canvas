ata-lucide=\"bar-chart-3\" class=\"w-5 h-5\" data-kid=\"103\"></i>\n      </div>\n      <span class=\"text-[9px] font-black uppercase tracking-[0.1em]\" data-kid=\"104\">Stats</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1.5 group w-[20%] text-slate-400\" data-kid=\"105\">\n      <div class=\"w-12 h-8 rounded-full flex items-center justify-center transition-all hover:bg-slate-50\" data-kid=\"106\">\n        <i data-lucide=\"sliders-horizontal\" class=\"w-5 h-5\" data-kid=\"107\"></i>\n      </div>\n      <span class=\"text-[9px] font-black uppercase tracking-[0.1em]\" data-kid=\"108\">Config</span>\n    </button>\n  </nav>\n\n</div>\n\n<style data-kid=\"109\">\n  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap');\n  \n  :root {\n    --font-sans: 'Outfit', sans-serif;\n  }\n\n  body {\n    font-family: var(--font-sans);\n    margin: 0;\n    padding: 0;\n    background-color: #f8fafc;\n  }\n\n  /* Custom Scrollbar for the main content area */\n  main::-webkit-scrollbar {\n    display: none;\n  }\n\n  /* Pulsate keyframes for more control if Tailwind's animate-pulse is too broad */\n  @keyframes subtle-pulsate {\n    0%, 100% { opacity: 0.4; transform: scale(0.95); }\n    50% { opacity: 0.8; transform: scale(1.05); }\n  }\n  \n  .animate-subtle-pulse {\n    animation: subtle-pulsate 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n  }\n</style>\n\n\n<script src=\"https://unpkg.com/lucide@latest\" data-kid=\"110\"></script>\n<script data-kid=\"111\">\n  lucide.createIcons();\n</script>\n",
