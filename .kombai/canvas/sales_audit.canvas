      "html": "\n<div class=\"w-[375px] h-[812px] bg-slate-50 flex flex-col overflow-hidden font-sans text-slate-900 border border-slate-200 shadow-2xl mx-auto relative\" data-kid=\"0\">\n  \n  \n  <header class=\"flex-none bg-white px-5 pt-12 pb-4 flex items-center justify-between z-20\" data-kid=\"1\">\n    <div class=\"flex items-center gap-3\" data-kid=\"2\">\n      <div class=\"w-11 h-11 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center border border-indigo-100/50\" data-kid=\"3\">\n        <i data-lucide=\"layout-grid\" class=\"w-6 h-6\" data-kid=\"4\"></i>\n      </div>\n      <div data-kid=\"5\">\n        <h1 class=\"text-xl font-black tracking-tight text-slate-900 leading-none\" data-kid=\"6\">Vault</h1>\n        <p class=\"text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] mt-1\" data-kid=\"7\">Audit Manager</p>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-2\" data-kid=\"8\">\n      <button class=\"w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-400 border border-slate-100 hover:bg-white hover:shadow-sm transition-all\" data-kid=\"9\">\n        <i data-lucide=\"search\" class=\"w-5 h-5\" data-kid=\"10\"></i>\n      </button>\n      <img src=\"https://i.pravatar.cc/100?u=sarah\" alt=\"Profile\" class=\"w-10 h-10 rounded-xl border-2 border-white shadow-md ring-1 ring-slate-100\" decoding=\"async\" loading=\"lazy\" data-kid=\"11\">\n    </div>\n  </header>\n\n  \n  <div class=\"flex-none z-30\" data-kid=\"12\">\n    <div class=\"bg-gradient-to-r from-indigo-700 to-violet-700 px-5 py-3 flex items-center justify-between shadow-xl shadow-indigo-200 relative overflow-hidden\" data-kid=\"13\">\n      \n      <div class=\"absolute inset-0 opacity-10 pointer-events-none\" data-kid=\"14\">\n        <div class=\"absolute top-0 right-0 w-24 h-24 bg-white rounded-full -mr-12 -mt-12\" data-kid=\"15\"></div>\n        <div class=\"absolute bottom-0 left-0 w-16 h-16 bg-white rounded-full -ml-8 -mb-8\" data-kid=\"16\"></div>\n      </div>\n      \n      <div class=\"flex items-center gap-3 relative z-10\" data-kid=\"17\">\n        <div class=\"relative flex items-center justify-center\" data-kid=\"18\">\n          <div class=\"absolute w-6 h-6 bg-white/30 rounded-full animate-ping\" data-kid=\"19\"></div>\n          <div class=\"relative w-8 h-8 bg-white/20 backdrop-blur-md rounded-lg flex items-center justify-center border border-white/30 shadow-sm\" data-kid=\"20\">\n             <i data-lucide=\"refresh-cw\" class=\"w-4 h-4 text-white animate-[spin_3s_linear_infinite]\" data-kid=\"21\"></i>\n          </div>\n        </div>\n        <div data-kid=\"22\">\n          <p class=\"text-xs font-bold text-white leading-tight tracking-wide\" data-kid=\"23\">Syncing Queued Data</p>\n          <div class=\"flex items-center gap-1.5 mt-0.5\" data-kid=\"24\">\n            <span class=\"inline-block w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse\" data-kid=\"25\"></span>\n            <p class=\"text-[10px] font-bold text-indigo-100/90 uppercase tracking-widest\" data-kid=\"26\">3 items in queue</p>\n          </div>\n        </div>\n      </div>\n      <button class=\"relative z-10 text-[10px] font-extrabold text-indigo-600 uppercase tracking-widest bg-white px-4 py-2 rounded-full shadow-xl hover:scale-105 transition-transform active:scale-95\" data-kid=\"27\">\n        Sync\n      </button>\n    </div>\n  </div>\n\n  \n  <main class=\"flex-1 overflow-y-auto px-5 pt-6 pb-32 space-y-6\" data-kid=\"28\">\n    \n    <section data-kid=\"29\">\n      <div class=\"flex items-center justify-between mb-4\" data-kid=\"30\">\n        <h2 class=\"text-sm font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"31\">Active Audits</h2>\n        <span class=\"text-[10px] font-bold px-2 py-0.5 bg-indigo-100 text-indigo-600 rounded-full\" data-kid=\"32\">3 IN PROGRESS</span>\n      </div>\n      \n      <div class=\"space-y-3\" data-kid=\"33\">\n        \n        