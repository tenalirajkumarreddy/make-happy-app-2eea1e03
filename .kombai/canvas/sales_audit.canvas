      "html": "\n<section class=\"min-h-[700px] w-[375px] bg-[#111111] p-4 font-['Inter'] antialiased\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6-96,400;700&family=Inter:wght@400;500;600;700&display=swap');\n\n    .luxury-shadow {\n      box-shadow: \n        inset 0 1px 1px rgba(255, 255, 255, 0.08),\n        0 24px 48px -12px rgba(0, 0, 0, 0.5);\n    }\n\n    .glass-effect {\n      background: rgba(255, 255, 255, 0.08);\n      backdrop-filter: blur(16px);\n      -webkit-backdrop-filter: blur(16px);\n      border: 1px solid rgba(255, 255, 255, 0.15);\n    }\n\n    .gold-glow {\n      text-shadow: 0 0 15px rgba(212, 175, 55, 0.6);\n    }\n\n    .gold-gradient {\n      background: linear-gradient(135deg, #f0d78c 0%, #d4af37 50%, #a68a2d 100%);\n    }\n\n    .gold-border-gradient {\n      border-image: linear-gradient(to bottom right, #f0d78c, #d4af37, #a68a2d) 1;\n    }\n    \n    .inner-border {\n      position: relative;\n    }\n    .inner-border::after {\n      content: '';\n      position: absolute;\n      inset: 0;\n      border-radius: inherit;\n      border: 1px solid rgba(255, 255, 255, 0.05);\n      pointer-events: none;\n    }\n  </style>\n\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"2\">\n\n  \n  <div class=\"luxury-shadow bg-[#2A3439] rounded-[48px] p-3 pb-8 inner-border overflow-hidden\" data-kid=\"3\">\n    \n    \n    <div class=\"relative w-full aspect-[4/3] mb-8\" data-kid=\"4\">\n      <div class=\"w-full h-full rounded-[38px] overflow-hidden shadow-2xl\" data-kid=\"5\">\n        <img src=\"https://images.unsplash.com/photo-1744776411221-72b8bb5665e6?auto=format&w=800&q=80&fit=crop\" alt=\"Restaurant Interior\" class=\"w-full h-full object-cover brightness-75 scale-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"6\">\n      </div>\n      \n      \n      <div class=\"glass-effect absolute 