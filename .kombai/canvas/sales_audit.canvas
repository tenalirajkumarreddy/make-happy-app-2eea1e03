   <span class=\"text-[9px] font-black text-emerald-600 px-2 py-1 bg-emerald-100/50 rounded-full shrink-0 uppercase tracking-wide\" data-kid=\"56\">IN STOCK</span>\n            </div>\n            <div class=\"flex items-center gap-3 mt-1\" data-kid=\"57\">\n              <span class=\"text-xs font-black text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md\" data-kid=\"58\">₹1,140</span>\n              <span class=\"text-[10px] text-slate-400 font-bold uppercase tracking-wide\" data-kid=\"59\">25kg Bag</span>\n            </div>\n            \n            <div class=\"flex items-center justify-between mt-3\" data-kid=\"60\">\n               <div class=\"flex items-center bg-slate-50 rounded-xl px-1 py-1 gap-2.5 border border-slate-100\" data-kid=\"61\">\n                 <button class=\"w-7 h-7 rounded-lg bg-white flex items-center justify-center text-slate-400 hover:text-red-500 hover:border-red-100 transition-all border border-slate-200 shadow-xs\" data-kid=\"62\">-</button>\n                 <span class=\"text-xs font-black text-slate-800 w-5 text-center\" data-kid=\"63\">02</span>\n                 <button class=\"w-7 h-7 rounded-lg bg-blue-600 flex items-center justify-center text-white shadow-md shadow-blue-200 transition-transform active:scale-95\" data-kid=\"64\">+</button>\n               </div>\n               <div class=\"text-right\" data-kid=\"65\">\n                  <p class=\"text-[10px] font-bold text-slate-400 uppercase leading-none\" data-kid=\"66\">Subtotal</p>\n                  <p class=\"text-sm font-black text-blue-900 mt-0.5\" data-kid=\"67\">₹2,280.00</p>\n               </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bg-white p-3.5 rounded-3xl border border-slate-100 flex items-center gap-4 shadow-sm hover:shadow-md transition-all\" data-kid=\"68\">\n          <div class=\"w-14 h-14 bg-slate-50 rounded-2xl flex items-center justify-center shrink-0 border border-slate-100\" data-kid=\"69\">\n       