      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  :root {\n    --primary: hsl(217 91% 50%);\n    --primary-foreground: hsl(0 0% 100%);\n    --background: hsl(220 20% 97%);\n    --foreground: hsl(220 25% 10%);\n    --muted: hsl(220 14% 96%);\n    --muted-foreground: hsl(220 10% 46%);\n    --success: hsl(142 72% 42%);\n    --destructive: hsl(0 84% 60%);\n    --border: hsl(220 13% 91%);\n    --radius: 0.75rem;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    background-color: var(--background);\n    color: var(--foreground);\n    margin: 0;\n  }\n\n  .font-mono {\n    font-family: 'JetBrains Mono', monospace;\n  }\n\n  .table-row-hover:hover {\n    box-shadow: inset 0 0 0 1px var(--primary);\n    background-color: white;\n  }\n\n  /* Custom scrollbar for panel */\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 5px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: var(--border);\n    border-radius: 10px;\n  }\n\n  .panel-slide-in {\n    animation: slideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  @keyframes slideIn {\n    from { transform: translateX(100%); }\n    to { transform: translateX(0); }\n  }\n\n  .overlay-fade-in {\n    animation: fadeIn 0.2s ease-out;\n  }\n\n  @keyframes fadeIn {\n    from { opacity: 0; }\n    to { opacity: 1; }\n  }\n</style>\n\n<script src=\"https://unpkg.com/lucide@latest\" data-kid=\"1\"></script>\n\n<div class=\"flex min-h-[900px] w-full bg-[var(--background)]\" data-kid=\"2\">\n  \n  <aside class=\"w-20 border-r border-[var(--border)] bg-white flex flex-col items-center py-8 gap-10 shrink-0 sticky top-0 h-full z-20\" data-kid=\"3\">\n    <div class=\"w-12 h-12 bg-[var(--primary)] rounded-2xl flex items-center justify-center shadow-lg shadow-blue-200/50 cursor-pointer hover:scale-105 transition-transform\" data-kid=\"4\">\n      <i data-lucide=\"zap\" class=\"w-7 h-7 text-white\" data-kid=\"5\"></i>\n    </div>\n    \n    <nav class=\"flex flex-col gap-6 flex-1\" data-kid=\"6\">\n      <button class=\"w-12 h-12 flex items-center justify-center rounded-xl text-slate-400 hover:bg-[var(--muted)] hover:text-[var(--primary)] transition-all group\" data-kid=\"7\">\n        <i data-lucide=\"layout-grid\" class=\"w-5 h-5 group-hover:scale-110 transition-transform\" data-kid=\"8\"></i>\n      </button>\n      <button class=\"w-12 h-12 flex items-center justify-center rounded-xl bg-blue-50 text-[var(--primary)] shadow-sm border border-blue-100 transition-all\" data-kid=\"9\">\n        <i data-lucide=\"receipt\" class=\"w-5 h-5\" data-kid=\"10\"></i>\n      </button>\n      <button class=\"w-12 h-12 flex items-center justify-center rounded-xl text-slate-400 hover:bg-[var(--muted)] hover:text-[var(--primary)] transition-all group\" data-kid=\"11\">\n        <i data-lucide=\"package\" class=\"w-5 h-5 group-hover:scale-110 transition-transform\" data-kid=\"12\"></i>\n      </button>\n      <button class=\"w-12 h-12 flex items-center justify-center rounded-xl text-slate-400 hover:bg-[var(--muted)] hover:text-[var(--primary)] transition-all group\" data-kid=\"13\">\n        <i data-lucide=\"users\" class=\"w-5 h-5 group-hover:scale-110 transition-transform\" data-kid=\"14\"></i>\n      </button>\n    </nav>\n\n    <div class=\"mt-auto flex flex-col gap-6 items-center\" data-kid=\"15\">\n      <button class=\"w-12 h-12 flex items-center justify-center rounded-xl text-slate-400 hover:bg-[var(--muted)] transition-all\" data-kid=\"16\">\n        <i data-lucide=\"settings\" class=\"w-5 h-5\" data-kid=\"17\"></i>\n      </button>\n      <div class=\"w-10 h-10 rounded-full border-2 border-[var(--border)] overflow-hidden shadow-sm hover:border-[var(--primary)] transition-colors cursor-pointer\" data-kid=\"18\">\n        <img src=\"https://i.pravatar.cc/150?u=salesadmin\" alt=\"User\" class=\"w-full h-full object-cover\" data-kid=\"19\">\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 p-8 max-w-7xl mx-auto space-y-6\" data-kid=\"20\">\n    \n    <header class=\"flex items-end justify-between\" data-kid=\"21\">\n      <div class=\"space-y-1\" data-kid=\"22\">\n        <div class=\"flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"23\">\n          Management <i data-lucide=\"chevron-right\" class=\"w-3 h-3\" data-kid=\"24\"></i> Sales\n        </div>\n        <div class=\"flex items-baseline gap-4\" data-kid=\"25\">\n          <h1 class=\"text-3xl font-extrabold text-slate-900 tracking-tight\" data-kid=\"26\">Sales Transactions</h1>\n          <span class=\"text-slate-500 font-bold text-sm bg-white px-3 py-1 rounded-full border border-[var(--border)]\" data-kid=\"27\">1,284 <span class=\"text-[10px] text-slate-400 uppercase ml-1\" data-kid=\"28\">Total</span></span>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-3\" data-kid=\"29\">\n        <button class=\"bg-white hover:bg-[var(--muted)] text-slate-600 px-4 py-2.5 rounded-xl font-semibold border border-[var(--border)] transition-all flex items-center gap-2 active:scale-95 shadow-sm\" data-kid=\"30\">\n          <i data-lucide=\"download\" class=\"w-4 h-4\" data-kid=\"31\"></i>\n          Export\n        </button>\n        <button onclick=\"document.getElementById('record-sale-panel').classList.remove('hidden')\" class=\"bg-[var(--primary)] hover:opacity-90 text-white px-6 py-2.5 rounded-xl font-bold shadow-lg shadow-blue-200/50 transition-all flex items-center gap-2 active:scale-95 cursor-pointer\" data-kid=\"32\">\n          <i data-lucide=\"plus\" class=\"w-5 h-5\" data-kid=\"33\"></i>\n          Record Sale\n        </button>\n      </div>\n    </header>\n\n    \n    <section class=\"flex items-center gap-3 w-full bg-white p-2 rounded-2xl border border-[var(--border)] shadow-sm\" data-kid=\"34\">\n      <div class=\"relative flex-1 group\" data-kid=\"35\">\n        <i data-lucide=\"search\" class=\"absolute left-4 top-1/2 -translate-y-1/2 w-4.5 h-4.5 text-slate-300 group-focus-within:text-[var(--primary)] transition-colors\" data-kid=\"36\"></i>\n        <input type=\"text\" placeholder=\"Search by sale ID, store or customer name...\" class=\"w-full pl-12 pr-4 py-3 bg-transparent text-sm focus:outline-none placeholder:text-slate-400 font-medium text-slate-700\" data-kid=\"37\">\n      </div>\n      \n      <div class=\"w-px h-8 bg-[var(--border)]\" data-kid=\"38\"></div>\n\n      <div class=\"flex items-center gap-2 relative\" data-kid=\"39\">\n        <button onclick=\"document.getElementById('filter-popover').classList.toggle('hidden')\" class=\"flex items-center gap-2.5 px-5 py-3 hover:bg-[var(--muted)] rounded-xl text-sm font-bold text-slate-600 transition-all border border-transparent hover:border-[var(--border)] group\" data-kid=\"40\">\n          <i data-lucide=\"filter\" class=\"w-4 h-4 text-slate-400 group-hover:text-[var(--primary)]\" data-kid=\"41\"></i>\n          Filters\n          <span class=\"flex items-center justify-center w-5 h-5 bg-[var(--primary)] text-white rounded-full text-[10px] font-black shadow-sm\" data-kid=\"42\">2</span>\n        </button>\n        \n        \n        <div id=\"filter-popover\" class=\"hidden absolute top-full right-0 mt-3 w-80 bg-white rounded-2xl shadow-2xl border border-[var(--border)] p-6 z-40 panel-slide-in\" data-kid=\"43\">\n          <div class=\"flex items-center justify-between mb-5\" data-kid=\"44\">\n            <h4 class=\"text-xs font-black text-slate-400 uppercase tracking-widest\" data-kid=\"45\">Filter Parameters</h4>\n            <button onclick=\"document.getElementById('filter-popover').classList.add('hidden')\" class=\"text-slate-300 hover:text-slate-600\" data-kid=\"46\">\n              <i data-lucide=\"x\" class=\"w-4 h-4\" data-kid=\"47\"></i>\n            </button>\n          </div>\n          <div class=\"space-y-4\" data-kid=\"48\">\n            <div class=\"space-y-2\" data-kid=\"49\">\n              <label class=\"text-[10px] font-black text-slate-500 uppercase\" data-kid=\"50\">Route</label>\n              <select class=\"w-full p-2.5 bg-[var(--muted)] border border-[var(--border)] rounded-xl text-xs font-bold outline-none\" data-kid=\"51\">\n                <option data-kid=\"52\">All Routes</option>\n                <option data-kid=\"53\">North Hub (N-01)</option>\n                <option data-kid=\"54\">South Hub (S-12)</option>\n              </select>\n            </div>\n            <div class=\"space-y-2\" data-kid=\"55\">\n              <label class=\"text-[10px] font-black text-slate-500 uppercase\" data-kid=\"56\">Store Type</label>\n              <select class=\"w-full p-2.5 bg-[var(--muted)] border border-[var(--border)] rounded-xl text-xs font-bold outline-none\" data-kid=\"57\">\n                <option data-kid=\"58\">All Types</option>\n                <option data-kid=\"59\">Supermarket</option>\n                <option data-kid=\"60\">General Store</option>\n              </select>\n            </div>\n            <div class=\"space-y-2\" data-kid=\"61\">\n              <label class=\"text-[10px] font-black text-slate-500 uppercase\" data-kid=\"62\">User</label>\n              <select class=\"w-full p-2.5 bg-[var(--muted)] border border-[var(--border)] rounded-xl text-xs font-bold outline-none\" data-kid=\"63\">\n                <option data-kid=\"64\">All Users</option>\n                <option data-kid=\"65\">Admin User</option>\n                <option data-kid=\"66\">Sales Agent</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"flex gap-2 mt-6\" data-kid=\"67\">\n            <button class=\"flex-1 py-2.5 bg-[var(--muted)] text-slate-600 rounded-xl text-xs font-bold hover:bg-slate-200 transition-all\" data-kid=\"68\">Reset</button>\n            <button class=\"flex-1 py-2.5 bg-[var(--primary)] text-white rounded-xl text-xs font-bold shadow-md\" data-kid=\"69\">Apply</button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"bg-white rounded-2xl border border-[var(--border)] shadow-sm overflow-hidden\" data-kid=\"70\">\n      <div class=\"overflow-x-auto\" data-kid=\"71\">\n        <table class=\"w-full text-left text-sm border-collapse\" data-kid=\"72\">\n          <thead data-kid=\"73\">\n            <tr class=\"bg-[var(--muted)]/50 border-b border-[var(--border)]\" data-kid=\"74\">\n              <th class=\"px-6 py-4 font-bold text-slate-400 uppercase tracking-wider text-[10px]\" data-kid=\"75\">Sale ID</th>\n              <th class=\"px-6 py-4 font-bold text-slate-400 uppercase tracking-wider text-[10px]\" data-kid=\"76\">Store & Customer</th>\n              <th class=\"px-6 py-4 font-bold text-slate-400 uppercase tracking-wider text-[10px]\" data-kid=\"77\">Amount</th>\n              <th class=\"px-6 py-4 font-bold text-slate-400 uppercase tracking-wider text-[10px] text-center\" data-kid=\"78\">Status & Mode</th>\n              <th class=\"px-6 py-4 font-bold text-slate-400 uppercase tracking-wider text-[10px] text-right\" data-kid=\"79\">Actions</th>\n            </tr>\n          </thead>\n          <tbody class=\"divide-y divide-[var(--border)]\" data-kid=\"80\">\n            \n            <tr class=\"table-row-hover transition-all cursor-pointer group\" data-kid=\"81\">\n              <td class=\"px-6 py-5\" data-kid=\"82\">\n                <div class=\"flex items-center gap-2\" data-kid=\"83\">\n                  <span class=\"font-mono text-[var(--primary)] font-semibold bg-blue-50 px-2 py-1 rounded text-xs\" data-kid=\"84\">SALE-8291</span>\n                </div>\n                <p class=\"text-[10px] text-slate-400 mt-1 font-medium\" data-kid=\"85\">10 Oct 2023, 14:20</p>\n              </td>\n              <td class=\"px-6 py-5\" data-kid=\"86\">\n              