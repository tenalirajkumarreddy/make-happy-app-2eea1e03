      "html": "\n<div class=\"bg-slate-50 font-sans min-h-[900px] text-slate-900 w-[375px] mx-auto overflow-hidden shadow-2xl border-x border-slate-200 relative\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n    \n    body {\n      font-family: 'Inter', sans-serif;\n    }\n\n    /* Custom shadow for cards */\n    .card-shadow {\n      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);\n    }\n  </style>\n\n  \n  <header class=\"bg-white border-b border-slate-100 px-4 py-4 relative z-20\" data-kid=\"2\">\n    <div class=\"flex items-center justify-between\" data-kid=\"3\">\n      <div data-kid=\"4\">\n        <h1 class=\"text-xl font-bold text-slate-900\" data-kid=\"5\">My Routes</h1>\n        <p class=\"text-[11px] font-medium text-slate-500 uppercase tracking-widest mt-0.5\" data-kid=\"6\">Tuesday, 24 Oct</p>\n      </div>\n      <div class=\"flex gap-2\" data-kid=\"7\">\n        <button class=\"h-10 w-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-600 border border-slate-100\" data-kid=\"8\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search\" data-kid=\"9\"><circle cx=\"11\" cy=\"11\" r=\"8\" data-kid=\"10\"></circle><path d=\"m21 21-4.3-4.3\" data-kid=\"11\"></path></svg>\n        </button>\n        <img src=\"https://i.pravatar.cc/150?u=agent1\" alt=\"Profile\" class=\"h-10 w-10 rounded-full border-2 border-white shadow-sm\" decoding=\"async\" loading=\"lazy\" data-kid=\"12\">\n      </div>\n    </div>\n  </header>\n\n  \n  <div class=\"p-4\" data-kid=\"13\">\n    <div class=\"bg-slate-900 rounded-2xl p-4 text-white card-shadow relative overflow-hidden\" data-kid=\"14\">\n      \n      <div class=\"absolute -right-4 -top