      "html": "\n<div class=\"w-[375px] mx-auto bg-zinc-50 min-h-[812px] pb-24 font-sans text-zinc-900 relative\" data-kid=\"0\">\n  \n  <div class=\"flex justify-between items-center px-6 py-3 text-[12px] font-semibold\" data-kid=\"1\">\n    <span data-kid=\"2\">9:41</span>\n    <div class=\"flex gap-1.5 items-center\" data-kid=\"3\">\n      <i class=\"lucide-signal h-3 w-3\" data-kid=\"4\"></i>\n      <i class=\"lucide-wifi h-3 w-3\" data-kid=\"5\"></i>\n      <i class=\"lucide-battery h-3 w-3\" data-kid=\"6\"></i>\n    </div>\n  </div>\n\n  \n  <header class=\"px-5 py-4 space-y-4\" data-kid=\"7\">\n    <div class=\"flex justify-between items-center\" data-kid=\"8\">\n      <div data-kid=\"9\">\n        <h1 class=\"text-2xl font-extrabold tracking-tight text-zinc-900\" data-kid=\"10\">Daily Routes</h1>\n        <p class=\"text-[11px] font-bold text-zinc-400 uppercase tracking-widest mt-0.5\" data-kid=\"11\">Friday, 24 May</p>\n      </div>\n      <div class=\"flex gap-2\" data-kid=\"12\">\n        <button class=\"h-10 w-10 rounded-full bg-white border border-zinc-200 text-zinc-600 flex items-center justify-center hover:bg-zinc-50 transition-all active:scale-90\" data-kid=\"13\">\n          <i data-lucide=\"search\" class=\"h-4 w-4\" data-kid=\"14\"></i>\n        </button>\n        <button class=\"h-10 w-10 rounded-full bg-white border border-zinc-200 text-zinc-600 flex items-center justify-center hover:bg-zinc-50 transition-all active:scale-90\" data-kid=\"15\">\n          <i data-lucide=\"bell\" class=\"h-4 w-4\" data-kid=\"16\"></i>\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"bg-white rounded-3xl p-5 border border-zinc-200 shadow-xl shadow-zinc-200/50 relative overflow-hidden group\" data-kid=\"17\">\n      <div class=\"absolute -top-4 -right-4 p-3 opacity-5 group-hover:opacity-10 transition-opacity rotate-12\" data-kid=\"18\">\n        <i data-lucide=\"map-pinned\" class=\"h-24 w-24 text-blue-600\" data-kid=\"19\"></i>\n      </div>\n      <div class=\"flex justify-between items-start mb-5 relative z-10\" data-kid=\"20\">\n        <div class=\"space-y-1\" data-kid=\"21\">\n          <span class=\"text-[9px] font-extrabold text-blue-600 uppercase tracking-widest px-2 py-0.5 bg-blue-50 rounded-full border border-blue-100 whitespace-nowrap\" data-kid=\"22\">In Progress</span>\n          <div class=\"flex items-center gap-1.5 mt-1.5\" data-kid=\"23\">\n            <h2 class=\"text-[15px] font-bold text-zinc-900\" data-kid=\"24\">South Extension B</h2>\n            <i data-lucide=\"chevron-down\" class=\"h-3.5 w-3.5 text-zinc-400\" data-kid=\"25\"></i>\n          </div>\n        </div>\n        <div class=\"text-right shrink-0\" data-kid=\"26\">\n          <p class=\"text-[10px] font-bold text-zinc-400 uppercase tracking-widest\" data-kid=\"27\">Balance O/S</p>\n          <p class=\"text-xl font-mono font-bold text-zinc-900 tabular-nums\" data-kid=\"28\">₹1,42,800</p>\n        </div>\n      </div>\n      \n      <div class=\"space-y-3 relative z-10\" data-kid=\"29\">\n        <div class=\"flex justify-between items-center\" data-kid=\"30\">\n          <div class=\"flex items-center gap-2\" data-kid=\"31\">\n             <div class=\"h-2 w-2 rounded-full bg-blue-600\" data-kid=\"32\"></div>\n             <span class=\"text-[11px] font-bold text-zinc-800\" data-kid=\"33\">5 / 14 <span class=\"text-zinc-400 font-medium ml-1\" data-kid=\"34\">Visits completed</span></span>\n          </div>\n          <span class=\"text-[11px] font-bold text-blue-600\" data-kid=\"35\">35%</span>\n        </div>\n        <div class=\"w-full h-2 bg-zinc-100 rounded-full overflow-hidden\" data-kid=\"36\">\n          <div class=\"h-full bg-blue-600 rounded-full w-[35%] transition-all duration-1000 ease-out shadow-[0_0_8px_rgba(37,99,235,0.4)]\" data-kid=\"37\"></div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <main class=\"px-5 space-y-6\" data-kid=\"38\">\n    \n    <div class=\"flex gap-2 overflow-x-auto no-scrollbar pb-1\" data-kid=\"39\">\n      <button class=\"px-4 py-2 rounded-full bg-blue-600 text-white text-[11px] font-bold whitespace-nowrap shadow-sm\" data-kid=\"40\">Upcoming</button>\n      <button class=\"px-4 py-2 rounded-full bg-white border border-zinc-200 text-zinc-500 text-[11px] font-bold whitespace-nowrap hover:bg-zinc-50\" data-kid=\"41\">Visited</button>\n      <button class=\"px-4 py-2 rounded-full bg-white border border-zinc-200 text-zinc-500 text-[11px] font-bold whitespace-nowrap hover:bg-zinc-50\" data-kid=\"42\">Nearby</button>\n      <button class=\"px-4 py-2 rounded-full bg-white border border-zinc-200 text-zinc-500 text-[11px] font-bold whitespace-nowrap hover:bg-zinc-50\" data-kid=\"43\">Pending Order</button>\n    </div>\n\n    \n    <div class=\"space-y-4 pb-12\" data-kid=\"44\">\n      \n      <div class=\"bg-white rounded-[22px] border border-zinc-200 shadow-sm overflow-hidden animate-in fade-in slide-in-from-bottom-2 duration-300\" data-kid=\"45\">\n        <div class=\"p-4 flex justify-between items-start\" data-kid=\"46\">\n          <div class=\"space-y-1.5 flex-1 min-w-0 pr-4\" data-kid=\"47\">\n            <div class=\"flex items-center gap-2\" data-kid=\"48\">\n              <span class=\"text-[9px] font-mono font-bold text-zinc-400 bg-zinc-100 px-1.5 py-0.5 rounded tracking-wider whitespace-nowrap\" data-kid=\"49\">ST-104</span>\n              <h3 class=\"text-[15px] font-bold text-zinc-900 truncate\" data-kid=\"50\">Siddhivinayak Super Mart</h3>\n            </div>\n            <p class=\"text-[11px] text-zinc-500 flex items-center gap-1\" data-kid=\"51\">\n              <i data-lucide=\"map-pin\" class=\"h-3 w-3 text-zinc-400\" data-kid=\"52\"></i>\n              Lane 4, Pocket B, South Extension\n            </p>\n            <div class=\"flex items-center gap-2 mt-2\" data-kid=\"53\">\n              <span class=\"px-2 py-0.5 rounded-full bg-amber-100/50 text-amber-700 text-[9px] font-extrabold border border-amber-200 flex items-center gap-1 whitespace-nowrap\" data-kid=\"54\">\n                <i data-lucide=\"alert-circle\" class=\"h-2.5 w-2.5\" data-kid=\"55\"></i> PRIORITY\n              </span>\n              <span class=\"px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-500 text-[9px] font-extrabold border border-zinc-200\" data-kid=\"56\">\n                RETAILER\n              </span>\n            </div>\n          </div>\n          <div class=\"text-right shrink-0\" data-kid=\"57\">\n            <p class=\"text-[9px] font-bold text-zinc-400 uppercase tracking-widest mb-0.5\" data-kid=\"58\">Outstanding</p>\n            <p class=\"text-base font-mono font-bold text-zinc-900\" data-kid=\"59\">₹24,500</p>\n          </div>\n        </div>\n        \n        <div class=\"px-4 pb-4 flex gap-2\" data-kid=\"60\">\n          <button class=\"grow bg-zinc-900 hover:bg-zinc-800 text-white h-11 rounded-xl text-[11px] font-extrabold tracking-widest flex items-center justify-center gap-2.5 transition-all active:scale-[0.97] shadow-lg shadow-zinc-900/10\" data-kid=\"61\">\n            <i data-lucide=\"play\" class=\"h-3.5 w-3.5 fill-current\" data-kid=\"62\"></i>\n            START VISIT\n          </button>\n          <button class=\"shrink-0 w-11 h-11 border border-zinc-200 bg-white text-zinc-600 rounded-xl flex items-center justify-center hover:bg-zinc-50 active:scale-90 transition-all\" data-kid=\"63\">\n            <i data-lucide=\"navigation\" class=\"h-4 w-4\" data-kid=\"64\"></i>\n          </button>\n          <button class=\"shrink-0 w-11 h-11 border border-zinc-200 bg-white text-zinc-600 rounded-xl flex items-center justify-center hover:bg-zinc-50 active:scale-90 transition-all\" data-kid=\"65\">\n            <i data-lucide=\"more-horizontal\" class=\"h-4 w-4\" data-kid=\"66\"></i>\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"bg-white rounded-[22px] border border-zinc-200 shadow-sm overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-300\" data-kid=\"67\">\n        <div class=\"p-4 flex justify-between items-start\" data-kid=\"68\">\n          <div class=\"space-y-1.5 flex-1 min-w-0 pr-4\" data-kid=\"69\">\n            <div class=\"flex items-center gap-2\" data-kid=\"70\">\n              <span class=\"text-[9px] font-mono font-bold text-zinc-400 bg-zinc-100 px-1.5 py-0.5 rounded tracking-wider whitespace-nowrap\" data-kid=\"71\">ST-108</span>\n              <h3 class=\"text-[15px] font-bold text-zinc-900 truncate\" data-kid=\"72\">Aggarwal Brothers</h3>\n            </div>\n            <p class=\"text-[11px] text-zinc-500 flex items-center gap-1\" data-kid=\"73\">\n              <i data-lucide=\"map-pin\" class=\"h-3 w-3 text-zinc-400\" data-kid=\"74\"></i>\n              Main Market Rd, South Extension\n            </p>\n            <div class=\"flex items-center gap-2 mt-2\" data-kid=\"75\">\n              <span class=\"px-2 py-0.5 rounded-full bg-blue-100/50 text-blue-700 text-[9px] font-extrabold border border-blue-200 whitespace-nowrap\" data-kid=\"76\">\n                10 MINS AWAY\n              </span>\n            </div>\n          </div>\n          <div class=\"text-right shrink-0\" data-kid=\"77\">\n            <p class=\"text-[9px] font-bold text-zinc-400 uppercase tracking-widest mb-0.5\" data-kid=\"78\">Outstanding</p>\n            <p class=\"text-base font-mono font-bold text-zinc-900\" data-kid=\"79\">₹8,120</p>\n          </div>\n        </div>\n        \n        <div class=\"px-4 pb-4 flex gap-2\" data-kid=\"80\">\n          <button class=\"grow bg-zinc-900 hover:bg-zinc-800 text-white h-11 rounded-xl text-[11px] font-extrabold tracking-widest flex items-center justify-center gap-2.5 transition-all active:scale-[0.97] shadow-lg shadow-zinc-900/10\" data-kid=\"81\">\n            <i data-lucide=\"play\" class=\"h-3.5 w-3.5 fill-current\" data-kid=\"82\"></i>\n            START VISIT\n          </button>\n          <button class=\"shrink-0 w-11 h-11 border border-zinc-200 bg-white text-zinc-600 rounded-xl flex items-center justify-center hover:bg-zinc-50 active:scale-90 transition-all\" data-kid=\"83\">\n            <i data-lucide=\"navigation\" class=\"h-4 w-4\" data-kid=\"84\"></i>\n          </button>\n          <button class=\"shrink-0 w-11 h-11 border border-zinc-200 bg-white text-zinc-600 rounded-xl flex items-center justify-center hover:bg-zinc-50 active:scale-90 transition-all\" data-kid=\"85\">\n            <i data-lucide=\"more-horizontal\" class=\"h-4 w-4\" data-kid=\"86\"></i>\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"bg-zinc-100/50 rounded-[22px] border border-zinc-200/60 overflow-hidden mb-12\" data-kid=\"87\">\n        <div class=\"p-4 flex justify-between items-start\" data-kid=\"88\">\n          <div class=\"space-y-1.5 flex-1 min-w-0 pr-4\" data-kid=\"89\">\n            <div class=\"flex items-center gap-2 opacity-60\" data-kid=\"90\">\n              <span class=\"text-[9px] font-mono font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded tracking-wider whitespace-nowrap\" data-kid=\"91\">ST-092</span>\n              <h3 class=\"text-[15px] font-bold text-zinc-900 line-through decoration-zinc-400\" data-kid=\"92\">Sharma Provision</h3>\n            </div>\n            <div class=\"flex items-center gap-1.5 mt-1\" data-kid=\"93\">\n              <span class=\"flex items-center gap-1 text-[10px] font-bold text-emerald-600 uppercase\" data-kid=\"94\">\n                <i data-lucide=\"check-circle\" class=\"h-3 w-3\" data-kid=\"95\"></i>\n                Visited • 09:24 AM\n              </span>\n            </div>\n          </div>\n          <div class=\"text-right shrink-0 opacity-60\" data-kid=\"96\">\n            <p class=\"text-[9px] font-bold text-zinc-400 uppercase tracking-widest mb-0.5\" data-kid=\"97\">Collected</p>\n            <p class=\"text-base font-mono font-bold text-emerald-600\" data-kid=\"98\">₹12,000</p>\n          </div>\n        </div>\n        <div class=\"px-4 pb-4\" data-kid=\"99\">\n          <button class=\"w-full bg-white border border-zinc-200 text-zinc-600 h-11 rounded-xl text-[12px] font-bold flex items-center justify-center gap-2 transition-all active:scale-[0.98]\" data-kid=\"100\">\n            <i data-lucide=\"file-text\" class=\"h-4 w-4\" data-kid=\"101\"></i>\n            VIEW SUMMARY\n          </button>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n  <nav class=\"absolute bottom-0 left-1/2 -translate-x-1/2 w-[375px] bg-white/95 backdrop-blur-md border-t border-zinc-200 z-[100] px-2 pb-6 pt-2 shadow-[0_-4px_24px_rgba(0,0,0,0.04)]\" data-kid=\"102\">\n    <div class=\"flex items-end h-16\" data-kid=\"103\">\n      <button class=\"flex-1 flex flex-col items-center justify-center h-full gap-1 group\" data-kid=\"104\">\n        <div class=\"p-1.5 rounded-xl group-active:bg-zinc-100 transition-colors\" data-kid=\"105\">\n          <i data-lucide=\"home\" class=\"h-5 w-5 text-zinc-400\" data-kid=\"106\"></i>\n        </div>\n        <span class=\"text-[10px] font-bold text-zinc-400 uppercase tracking-wider\" data-kid=\"107\">Home</span>\n      </button>\n\n      <button class=\"flex-1 flex flex-col items-center justify-center h-full gap-1 group relative\" data-kid=\"108\">\n        <div class=\"absolute -top-1 left-1/2 -translate-x-1/2 h-0.5 w-6 bg-blue-600 rounded-b-full\" data-kid=\"109\"></div>\n        <div class=\"p-1.5 rounded-xl bg-blue-50 transition-colors\" data-kid=\"110\">\n          <i data-lucide=\"map\" class=\"h-5 w-5 text-blue-600\" data-kid=\"111\"></i>\n        </div>\n        <span class=\"text-[10px] font-bold text-blue-600 uppercase tracking-wider\" data-kid=\"112\">Routes</span>\n      </button>\n\n      <button class=\"flex-1 flex flex-col items-center justify-end pb-3 relative group\" data-kid=\"113\">\n        <div class=\"h-14 w-14 rounded-full bg-blue-600 flex items-center justify-center -mt-8 shadow-lg shadow-blue-600/30 active:scale-95 transition-all\" data-kid=\"114\">\n          <i data-lucide=\"scan-line\" class=\"h-6 w-6 text-white\" data-kid=\"115\"></i>\n        </div>\n        <span class=\"text-[10px] font-bold text-zinc-400 uppercase tracking-wider mt-1.5\" data-kid=\"116\">Scan</span>\n      </button>\n\n      <button class=\"flex-1 flex flex-col items-center justify-center h-full gap-1 group\" data-kid=\"117\">\n        <div class=\"p-1.5 rounded-xl group-active:bg-zinc-100 transition-colors\" data-kid=\"118\">\n          <i data-lucide=\"users\" class=\"h-5 w-5 text-zinc-400\" data-kid=\"119\"></i>\n        </div>\n        <span class=\"text-[10px] font-bold text-zinc-400 uppercase tracking-wider\" data-kid=\"120\">Stores</span>\n      </button>\n\n      <button class=\"flex-1 flex flex-col items-center justify-center h-full gap-1 group\" data-kid=\"121\">\n        <div class=\"p-1.5 rounded-xl group-active:bg-zinc-100 transition-colors\" data-kid=\"122\">\n          <i data-lucide=\"history\" class=\"h-5 w-5 text-zinc-400\" data-kid=\"123\"></i>\n        </div>\n        <span class=\"text-[10px] font-bold text-zinc-400 uppercase tracking-wider\" data-kid=\"124\">History</span>\n      </button>\n    </div>\n  </nav>\n\n  \n  <div class=\"absolute bottom-36 right-6 z-[90]\" data-kid=\"125\">\n    <button class=\"h-14 w-14 rounded-2xl bg-zinc-900 text-white flex items-center justify-center shadow-2xl active:scale-90 transition-all border border-zinc-800 rotate-45 group\" data-kid=\"126\">\n      <i data-lucide=\"plus\" class=\"h-7 w-7 -rotate-45 group-active:scale-110 transition-transform\" data-kid=\"127\"></i>\n    </button>\n  </div>\n</div>\n\n<script src=\"https://unpkg.com/lucide@latest\" data-kid=\"128\"></script>\n<script data-kid=\"129\">\n  lucide.createIcons();\n</script>\n\n<style data-kid=\"130\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');\n  \n  .font-sans { font-family: 'Inter', sans-serif; }\n  .font-mono { font-family: 'JetBrains+Mono', monospace; }\n\n  .no-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .no-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n\n  /* Tailwind Animate mock */\n  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }\n  @keyframes slide-in-from-bottom { from { transform: translateY(12px); } to { transform: translateY(0); } }\n  .animate-in { animation: fade-in 0.3s ease-out, slide-in-from-bottom 0.3s ease-out; }\n  .fade-in { animation-name: fade-in; }\n  .slide-in-from-bottom-2 { animation-name: slide-in-from-bottom; animation-duration: 0.3s; }\n  .slide-in-from-bottom-4 { animation-name: slide-in-from-bottom; animation-duration: 0.5s; }\n</style>\n",
