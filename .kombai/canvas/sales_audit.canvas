      \n      <button class=\"flex-1 flex flex-col items-center justify-center h-full group active:scale-90 transition-transform\" data-kid=\"153\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-slate-400 group-active:text-slate-600 mb-1 transition-colors\" data-kid=\"154\"><path d=\"M21 12V7H5a2 2 0 0 1 0-4h14v4\" data-kid=\"155\"></path><path d=\"M3 5v14a2 2 0 0 0 2 2h16v-5\" data-kid=\"156\"></path><path d=\"M18 12a2 2 0 0 0 0 4h4v-4Z\" data-kid=\"157\"></path></svg>\n        <span class=\"text-[10px] font-bold text-slate-400 uppercase tracking-tighter\" data-kid=\"158\">Ledger</span>\n      </button>\n\n      \n      <button class=\"flex-1 flex flex-col items-center justify-center h-full group active:scale-90 transition-transform\" data-kid=\"159\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-slate-400 group-active:text-slate-600 mb-1 transition-colors\" data-kid=\"160\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\" data-kid=\"161\"></path><circle cx=\"12\" cy=\"7\" r=\"4\" data-kid=\"162\"></circle></svg>\n        <span class=\"text-[10px] font-bold text-slate-400 uppercase tracking-tighter\" data-kid=\"163\">Profile</span>\n      </button>\n\n    </div>\n  </nav>\n\n</div>\n",
