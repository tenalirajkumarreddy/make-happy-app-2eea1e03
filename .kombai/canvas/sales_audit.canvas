ansform duration-500\" alt=\"Product\" data-kid=\"209\">\n              </div>\n              <div class=\"flex-1 min-w-0\" data-kid=\"210\">\n                <h4 class=\"text-xs font-bold text-slate-900 truncate\" data-kid=\"211\">Premium Ceylon Tea</h4>\n                <div class=\"flex items-center gap-2 mt-0.5\" data-kid=\"212\">\n                  <span class=\"text-xs font-mono font-bold text-slate-600\" data-kid=\"213\">₹650.00</span>\n                  <span class=\"text-[9px] font-bold bg-orange-50 text-orange-600 px-1.5 py-0.5 rounded border border-orange-100\" data-kid=\"214\">Stock: 8</span>\n                </div>\n              </div>\n              <div class=\"flex items-center bg-white rounded-lg p-1 gap-1 border border-blue-200\" data-kid=\"215\">\n                <button class=\"w-7 h-7 flex items-center justify-center hover:bg-[var(--muted)] rounded-md text-slate-400 transition-all active:scale-90\" data-kid=\"216\">\n                  <i data-lucide=\"minus\" class=\"w-3.5 h-3.5\" data-kid=\"217\"></i>\n                </button>\n                <span class=\"w-8 text-center text-xs font-mono font-bold text-slate-900\" data-kid=\"218\">5</span>\n                <button class=\"w-7 h-7 flex items-center justify-center bg-[var(--primary)] text-white rounded-md transition-all active:scale-90 shadow-md\" data-kid=\"219\">\n                  <i data-lucide=\"plus\" class=\"w-3.5 h-3.5\" data-kid=\"220\"></i>\n                </button>\n              </div>\n            </div>\n\n            \n            <button class=\"w-full py-3 border-2 border-dashed border-[var(--border)] rounded-xl text-[10px] font-black text-slate-400 hover:text-[var(--primary)] hover:border-[var(--primary)] hover:bg-blue-50 transition-all uppercase tracking-widest\" data-kid=\"221\">\n              + Load All Products\n            </button>\n          </div>\n        </div>\n\n        \n        <div class=\"space-y-4\" data-kid=\"222\">\n          <label class=\"text-[10px] 