16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"71\"><path d=\"m9 18 6-6-6-6\" data-kid=\"72\"></path></svg>\n          </button>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"stagger-3 space-y-4\" data-kid=\"73\">\n      <h2 class=\"text-[11px] font-extrabold text-slate-400 uppercase tracking-widest px-1\" data-kid=\"74\">Quick Actions</h2>\n      <div class=\"grid grid-cols-4 gap-4\" data-kid=\"75\">\n        <div class=\"flex flex-col items-center gap-2.5\" data-kid=\"76\">\n          <button class=\"w-14 h-14 rounded-[22px] bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-100 tactile-button\" data-kid=\"77\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"78\"><path d=\"M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z\" data-kid=\"79\"></path><path d=\"M3 6h18\" data-kid=\"80\"></path><path d=\"M16 10a4 4 0 0 1-8 0\" data-kid=\"81\"></path></svg>\n          </button>\n          <span class=\"text-[10px] font-bold text-slate-500 text-center leading-tight\" data-kid=\"82\">Sales</span>\n        </div>\n        <div class=\"flex flex-col items-center gap-2.5\" data-kid=\"83\">\n          <button class=\"w-14 h-14 rounded-[22px] bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-100 tactile-button\" data-kid=\"84\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"85\"><rect width=\"20\" height=\"14\" x=\"2\" y=\"5\" rx=\"2\" data-kid=\"86\"></rect><line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\" data-kid=\"87\"></line></svg>\n      