      "html": "\n<div class=\"min-h-[800px] w-full bg-[#f0f0f0] p-4 flex justify-center items-start font-['IBM_Plex_Sans']\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .brutalist-border {\n      border: 3px solid #111111;\n    }\n\n    .brutalist-shadow {\n      box-shadow: 4px 4px 0px #111111;\n    }\n\n    .brutalist-shadow-sm {\n      box-shadow: 2px 2px 0px #111111;\n    }\n\n    .font-heading {\n      font-family: 'Space Grotesk', sans-serif;\n    }\n\n    .notch-tag {\n      background: #111111;\n      color: #FFFFFF;\n      padding: 2px 10px 2px 6px;\n      clip-path: polygon(0% 0%, 90% 0%, 100% 50%, 90% 100%, 0% 100%);\n      display: inline-block;\n      font-weight: 800;\n      font-size: 11px;\n      letter-spacing: 0.05em;\n    }\n\n    .action-button {\n      background: #FFFFFF;\n      transition: all 0.1s ease-in-out;\n      cursor: pointer;\n    }\n\n    .action-button:active {\n      background: #FDEE00;\n      transform: translate(2px, 2px);\n      box-shadow: 0px 0px 0px #111111;\n    }\n\n    .sale-btn:active {\n      background: #111111;\n      color: #FDEE00;\n    }\n  </style>\n\n  <div class=\"w-[375px] bg-white brutalist-border brutalist-shadow relative\" data-kid=\"2\">\n    \n    <div class=\"p-4 flex gap-4 items-start\" data-kid=\"3\">\n      \n      <div class=\"w-24 h-24 shrink-0 brutalist-border overflow-hidden bg-white\" data-kid=\"4\">\n        <img src=\"https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&w=300&q=80&fit=crop\" alt=\"Warehouse Interior\" class=\"w-full h-full object-cover grayscale contrast-125\" decoding=\"async\" loading=\"lazy\" data-kid=\"5\">\n      </div>\n\n      \n      <div class=\"flex-1 min-w-0\" data-kid=\"6\">\n        <h1 class=\"font-heading font-black text-2xl leading-[0.9] text-[#111111] uppercase break-words\" data-kid=\"7\">\n          METRO WHOLESALE #04\n        </h1>\n        \n        <div class=\"mt-3\" data-kid=\"8\">\n          <span class=\"notch-tag text-[12px] py-1 pl-2 pr-4\" data-kid=\"9\">S-10293</span>\n        </div>\n\n        <div class=\"mt-4 flex items-center gap-1.5\" data-kid=\"10\">\n          <div class=\"w-5 h-5 bg-[#111111] flex items-center justify-center\" data-kid=\"11\">\n            <i class=\"ti ti-route text-[12px] text-white\" data-kid=\"12\"></i>\n          </div>\n          <p class=\"font-heading font-bold text-[11px] text-[#111111] uppercase tracking-wider\" data-kid=\"13\">\n            North-End Drive\n          </p>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"mx-4 bg-[#FDEE00] brutalist-border p-3 flex flex-col relative overflow-hidden brutalist-shadow-sm group\" data-kid=\"14\">\n      \n      <div class=\"absolute inset-0 opacity-20 pointer-events-none\" style=\"background-image: radial-gradient(#111 2px, transparent 2px); background-size: 10px 10px;\" data-kid=\"15\"></div>\n      \n      <div class=\"relative z-10 flex justify-between items-center\" data-kid=\"16\">\n        <div data-kid=\"17\">\n          <span class=\"font-heading font-black text-[11px] uppercase tracking-wide text-[#111111] leading-none\" data-kid=\"18\">\n            Outstanding Balance\n          </span>\n          <div class=\"flex items-baseline mt-2\" data-kid=\"19\">\n            <span class=\"font-heading font-black text-4xl text-[#111111] tracking-tighter\" data-kid=\"20\">₹45,200</span>\n            <span class=\"font-heading font-black text-xl text-[#111111] ml-1\" data-kid=\"21\">.50</span>\n          </div>\n        </div>\n        \n        <div class=\"w-12 h-12 bg-white brutalist-border flex items-center justify-center brutalist-shadow-sm\" data-kid=\"22\">\n          <i class=\"ti ti-wallet text-2xl text-[#111111]\" data-kid=\"23\"></i>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"mt-8 px-4\" data-kid=\"24\">\n      <div class=\"w-full h-[3px] bg-[#111111]\" data-kid=\"25\"></div>\n      <div class=\"py-4 flex gap-3 items-start\" data-kid=\"26\">\n        <div class=\"shrink-0 mt-0.5\" data-kid=\"27\">\n          <i class=\"ti ti-map-pin-filled text-[#111111]\" data-kid=\"28\"></i>\n        </div>\n        <p class=\"text-xs font-bold leading-relaxed text-[#111111] uppercase font-['IBM_Plex_Sans']\" data-kid=\"29\">\n          128 Industrial Estate, Block C, Outer Ring Road, Hebbal, Bangalore 560099\n        </p>\n      </div>\n      <div class=\"w-full h-[3px] bg-[#111111]\" data-kid=\"30\"></div>\n    </div>\n\n    \n    <div class=\"p-4 space-y-2 mt-2\" data-kid=\"31\">\n      \n      <div class=\"grid grid-cols-2 gap-2\" data-kid=\"32\">\n        <button class=\"action-button sale-btn brutalist-border brutalist-shadow-sm h-24 flex flex-col items-center justify-center group\" data-kid=\"33\">\n          <i class=\"ti ti-shopping-cart-filled text-4xl mb-1\" data-kid=\"34\"></i>\n          <span class=\"font-heading font-black text-[12px] uppercase tracking-wider\" data-kid=\"35\">Record Sale</span>\n        </button>\n        <button class=\"action-button brutalist-border brutalist-shadow-sm h-24 flex flex-col items-center justify-center group\" data-kid=\"36\">\n          <i class=\"ti ti-wallet-filled text-4xl mb-1\" data-kid=\"37\"></i>\n          <span class=\"font-heading font-black text-[12px] uppercase tracking-wider\" data-kid=\"38\">Payment</span>\n        </button>\n      </div>\n\n      \n      <div class=\"grid grid-cols-3 gap-2\" data-kid=\"39\">\n        <button class=\"action-button brutalist-border brutalist-shadow-sm aspect-square flex flex-col items-center justify-center\" data-kid=\"40\">\n          <i class=\"ti ti-map-2 text-2xl mb-1\" style=\"stroke-width: 2.5;\" data-kid=\"41\"></i>\n          <span class=\"font-heading font-black text-[10px