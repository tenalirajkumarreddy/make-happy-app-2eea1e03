center justify-center p-3 rounded-xl hover:bg-slate-50 text-slate-700\" data-kid=\"128\">\n        <i class=\"lucide-navigation w-5 h-5 mb-1 text-blue-500\" data-kid=\"129\"></i>\n        <span class=\"text-[10px] font-bold uppercase\" data-kid=\"130\">Navigate</span>\n      </button>\n      <button class=\"flex flex-col items-center justify-center p-3 rounded-xl hover:bg-slate-50 text-slate-700\" data-kid=\"131\">\n        <i class=\"lucide-history w-5 h-5 mb-1 text-indigo-500\" data-kid=\"132\"></i>\n        <span class=\"text-[10px] font-bold uppercase\" data-kid=\"133\">History</span>\n      </button>\n    </div>\n  </div>\n\n  \n  <nav class=\"absolute bottom-0 left-0 w-full bg-white border-t border-slate-100 flex justify-around items-center h-16 px-4 z-30\" data-kid=\"134\">\n    <button class=\"flex flex-col items-center gap-1 text-blue-600\" data-kid=\"135\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin\" data-kid=\"136\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\" data-kid=\"137\"></path><circle cx=\"12\" cy=\"10\" r=\"3\" data-kid=\"138\"></circle></svg>\n      <span class=\"text-[10px] font-bold\" data-kid=\"139\">Routes</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1 text-slate-400 hover:text-slate-600\" data-kid=\"140\">\n      <i class=\"lucide-shopping-bag w-6 h-6\" data-kid=\"141\"></i>\n      <span class=\"text-[10px] font-bold\" data-kid=\"142\">Orders</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1 text-slate-400 hover:text-slate-600\" data-kid=\"143\">\n      <i class=\"lucide-bar-chart-3 w-6 h-6\" data-kid=\"144\"></i>\n      <span class=\"text-[10px] font-bold\" data-kid=\"145\">Stats</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1 text-slate-400 hover:text-