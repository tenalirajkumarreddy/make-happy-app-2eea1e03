ration-300 relative overflow-hidden\" data-kid=\"50\">\n          <div class=\"absolute top-0 left-0 w-1 h-full bg-indigo-500 opacity-50\" data-kid=\"51\"></div>\n          <div class=\"flex items-center gap-4\" data-kid=\"52\">\n            <div class=\"w-12 h-12 rounded-xl bg-indigo-50 flex items-center justify-center shrink-0\" data-kid=\"53\">\n              <i data-lucide=\"shopping-cart\" class=\"w-6 h-6 text-indigo-400\" data-kid=\"54\"></i>\n            </div>\n            <div class=\"flex-1 min-w-0\" data-kid=\"55\">\n              <div class=\"flex justify-between items-start\" data-kid=\"56\">\n                <h3 class=\"font-bold text-slate-800 text-sm truncate\" data-kid=\"57\">Westfield Superstore</h3>\n                <div class=\"flex items-center gap-1 shrink-0\" data-kid=\"58\">\n                  <div class=\"w-1.5 h-1.5 bg-indigo-400 rounded-full animate-pulse\" data-kid=\"59\"></div>\n                  <span class=\"text-[10px] font-bold text-indigo-400 uppercase\" data-kid=\"60\">Queued</span>\n                </div>\n              </div>\n              <p class=\"text-xs text-slate-500 mt-1 font-medium\" data-kid=\"61\">Audit #8830 • 5m ago</p>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"group bg-white p-4 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300 relative overflow-hidden\" data-kid=\"62\">\n          <div class=\"absolute top-0 left-0 w-1 h-full bg-indigo-500 opacity-30\" data-kid=\"63\"></div>\n          <div class=\"flex items-center gap-4\" data-kid=\"64\">\n            <div class=\"w-12 h-12 rounded-xl bg-indigo-50 flex items-center justify-center shrink-0\" data-kid=\"65\">\n              <i data-lucide=\"package\" class=\"w-6 h-6 text-indigo-300\" data-kid=\"66\"></i>\n            </div>\n            <div class=\"flex-1 min-w-0\" data-kid=\"67\">\n              <div class=\"flex justify-between items-start\" data-kid=\"68\">\n                <h3 class=\"font-bold text-slate-800 text-sm truncate\" data-kid=\"69\">Central Logistics Hub</h3>\n                <div class=\"flex items-center gap-1 shrink-0\" data-kid=\"70\">\n                  <div class=\"w-1.5 h-1.5 bg-indigo-300 rounded-full animate-pulse\" data-kid=\"71\"></div>\n                  <span class=\"text-[10px] font-bold text-indigo-300 uppercase\" data-kid=\"72\">Queued</span>\n                </div>\n              </div>\n              <p class=\"text-xs text-slate-500 mt-1 font-medium\" data-kid=\"73\">Audit #8829 • 12m ago</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section data-kid=\"74\">\n      <div class=\"flex items-center justify-between mb-4\" data-kid=\"75\">\n        <h2 class=\"text-sm font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"76\">History</h2>\n        <button class=\"text-[10px] font-bold text-indigo-600 uppercase tracking-widest\" data-kid=\"77\">See All</button>\n      </div>\n\n      <div class=\"space-y-3 opacity-60\" data-kid=\"78\">\n        <div class=\"bg-white/50 p-4 rounded-2xl border border-slate-100 flex items-center gap-4\" data-kid=\"79\">\n          <div class=\"w-12 h-12 rounded-xl bg-green-50 flex items-center justify-center shrink-0\" data-kid=\"80\">\n            <i data-lucide=\"check-circle\" class=\"w-6 h-6 text-green-500\" data-kid=\"81\"></i>\n          </div>\n          <div class=\"flex-1 min-w-0\" data-kid=\"82\">\n            <h3 class=\"font-bold text-slate-700 text-sm truncate\" data-kid=\"83\">Eastside Mall</h3>\n            <p class=\"text-xs text-slate-400 mt-0.5\" data-kid=\"84\">Audit #8827 • 2h ago</p>\n          </div>\n          <span class=\"text-[10px] font-bold text-green-600 uppercase\" data-kid=\"85\">Synced</span>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  \n  <nav class=\"flex-none bg-white border-t border-slate-100 px-6 pt-3 pb-8 flex items-center justify-between z-20\" data-kid=\"86\">\