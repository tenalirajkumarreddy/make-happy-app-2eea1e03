.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\r\n                    />\r\n                    <path\r\n                      fill=\"currentColor\"\r\n                      d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"\r\n                    />\r\n                    <path\r\n                      fill=\"currentColor\"\r\n                      d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"\r\n                    />\r\n                  </svg>\r\n                  Link Google Account\r\n                </>\r\n              )}\r\n            </button>\r\n            {!googleLinkingEnabled && (\r\n              <p className=\"text-xs text-slate-500 mt-2\">Google linking is currently disabled.</p>\r\n            )}\r\n          </>\r\n        )}\r\n      </div>\r\n\r\n      {customerCare && (\r\n        <button\r\n          type=\"button\"\r\n          onClick={() => window.open(`tel:${customerCare}`, \"_self\")}\r\n          className=\"w-full h-11 rounded-xl border border-primary/30 text-primary font-semibold text-sm flex items-center justify-center gap-2\"\r\n        >\r\n          <Phone className=\"h-4 w-4\" />\r\n          Call Support\r\n        </button>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\nfunction InfoRow({ label, value }: { label: string; value: string }) {\r\n  return (\r\n    <div className=\"flex items-center justify-between gap-3\">\r\n      <span className=\"text-slate-500\">{label}</span>\r\n      <span className=\"text-slate-900 dark:text-slate-100 text-right\">{value}</span>\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\rajku\\Documents\\PUBLIC PROJECTS\\make-happy-app-2eea1e03\\src\\mobile\\pages\\customer\\CustomerSales.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount